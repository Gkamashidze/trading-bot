# ==============================================================================
# trading-bot — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ==============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trading_bot:changeme@localhost:5432/trading_bot_dev
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# ── Binance API (READ-ONLY key — no trade, no withdraw permissions) ───────────
# Exchange-side: IP whitelist enforced, withdrawal DISABLED
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true             # true = testnet, false = mainnet

# ── Binance Trade-Only key (Stage 5+) — separate key, withdrawal DISABLED ────
# BINANCE_TRADE_API_KEY=
# BINANCE_TRADE_API_SECRET=

# ── Alpaca (Paper Trading — Stage 5) ─────────────────────────────────────────
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Telegram Alerts ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ── Redis (Stage 7+, optional) ────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=trading-bot
OTEL_EXPORTER_OTLP_ENDPOINT=     # leave empty to use console exporter in dev
OTEL_TRACES_SAMPLER=always_on

# ── Prometheus ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Feature Flags ─────────────────────────────────────────────────────────────
# All flags default to safe values in feature_flags.yaml
# Override per-environment here if needed:
# FEATURE_FLAG_LIVE_TRADING_ENABLED=false

# ── Security ──────────────────────────────────────────────────────────────────
# SECRET_KEY used for HMAC signing of internal tokens (generate with: openssl rand -hex 32)
SECRET_KEY=

# ── API Key Rotation Reminder ─────────────────────────────────────────────────
# Rotate ALL exchange API keys every 90 days.
# Last rotated: YYYY-MM-DD
# Next rotation due: YYYY-MM-DD
